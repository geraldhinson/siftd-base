    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${file}",
            "env": {
                "RESDIR_PATH": "${workspaceFolder}",
                "SIFTD_ENV_FILE": "${workspaceFolder}/app.env"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug All Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "env": {
                "RESDIR_PATH": "${workspaceFolder}",
                "SIFTD_ENV_FILE": "${workspaceFolder}/app.env"
            },
            "args": [
                "-test.v"
            ]
        }
